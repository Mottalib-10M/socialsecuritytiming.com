---
import Layout from '../../layouts/Layout.astro';

const title = 'Legal Notice — SocialSecurityTiming.com';
const description = 'Legal notice and terms of use for SocialSecurityTiming.com Social Security claiming age optimizer.';
---

<Layout title={title} description={description}>
  <div class="max-w-3xl mx-auto space-y-6">
    <h1 class="text-4xl font-bold text-gray-900">Legal Notice</h1>
    <p class="text-sm text-gray-500">Last updated: July 2026</p>

    <section class="space-y-4 text-gray-700 leading-relaxed">
      <h2 class="text-2xl font-semibold text-gray-900">Disclaimer</h2>
      <p>
        SocialSecurityTiming.com provides educational tools and information for estimating Social Security retirement benefits. The calculations, projections, and information on this website are for informational purposes only and do not constitute financial, tax, legal, or investment advice.
      </p>
      <p>
        This website is not affiliated with, endorsed by, or connected to the Social Security Administration (SSA), the United States government, or any government agency. The name "Social Security" is used solely for descriptive purposes.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Accuracy of Information</h2>
      <p>
        While we strive to provide accurate and up-to-date information based on publicly available SSA data, we make no warranties or guarantees regarding the accuracy, completeness, or reliability of any calculations or content on this site. Social Security rules, bend points, thresholds, and regulations change annually and may differ from the values used in our calculator.
      </p>
      <p>
        The calculations use 2026 bend points and rates. Actual benefits depend on your complete earnings history, future COLA adjustments, legislative changes, and individual circumstances that this calculator cannot account for.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Not Professional Advice</h2>
      <p>
        The information on this website should not be used as a substitute for professional financial advice. We strongly recommend consulting with a qualified financial advisor, tax professional, or the Social Security Administration directly before making claiming decisions.
      </p>
      <p>
        You can access your official Social Security statement and benefit estimates at <a href="https://www.ssa.gov/myaccount/" target="_blank" rel="noopener noreferrer" class="text-primary underline">ssa.gov/myaccount</a>.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Limitation of Liability</h2>
      <p>
        SocialSecurityTiming.com, its owners, operators, and contributors shall not be held liable for any direct, indirect, incidental, consequential, or punitive damages arising from the use of this website or reliance on any information provided herein. Use of this calculator is at your own risk.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Intellectual Property</h2>
      <p>
        All original content, code, and design on this website is the property of SocialSecurityTiming.com. The underlying Social Security formulas and rules are public domain information published by the Social Security Administration.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">External Links</h2>
      <p>
        This website may contain links to external resources including SSA.gov. We are not responsible for the content, accuracy, or availability of external websites. Links to external sites do not imply endorsement.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Contact</h2>
      <p>
        For questions about this legal notice, please contact us through our website.
      </p>
    </section>
  </div>
</Layout>
