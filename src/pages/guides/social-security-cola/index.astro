        <li><a href="https://www.ssa.gov/oact/cola/autoAdj.html" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">SSA.gov - Automatic COLA Adjustment Information</a></li>
      </ul>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://socialsecuritytiming.com/" },
      { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://socialsecuritytiming.com/guides/" },
