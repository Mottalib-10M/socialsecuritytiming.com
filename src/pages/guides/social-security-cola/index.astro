          When to Claim Guide
        </a>
      </div>
    </div>

    <!-- Sources -->
    <section class="space-y-3">
      <h3 class="text-lg font-semibold text-gray-900">Sources</h3>
      <ul class="text-sm text-gray-600 space-y-2">
        <li><a href="https://www.ssa.gov/oact/cola/colaseries.html" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">SSA.gov - Historical COLA Data</a></li>
        <li><a href="https://www.ssa.gov/oact/cola/latestCOLA.html" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">SSA.gov - Latest COLA</a></li>
