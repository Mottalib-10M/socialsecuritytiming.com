---
import Layout from '../../layouts/Layout.astro';

const title = 'Privacy Policy — SocialSecurityTiming.com';
const description = 'Privacy policy for SocialSecurityTiming.com. Learn how we handle your data when you use our Social Security claiming age calculator.';
---

<Layout title={title} description={description}>
  <div class="max-w-3xl mx-auto space-y-6">
    <h1 class="text-4xl font-bold text-gray-900">Privacy Policy</h1>
    <p class="text-sm text-gray-500">Last updated: July 2026</p>

    <section class="space-y-4 text-gray-700 leading-relaxed">
      <h2 class="text-2xl font-semibold text-gray-900">Overview</h2>
      <p>
        SocialSecurityTiming.com is committed to protecting your privacy. This privacy policy explains what information we collect, how we use it, and your rights regarding your data.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Data Collection</h2>
      <h3 class="text-lg font-semibold text-gray-900">Calculator Data</h3>
      <p>
        All calculations are performed entirely in your web browser (client-side). The financial information you enter into our calculator — including PIA, AIME, birth year, life expectancy, and other inputs — is never transmitted to our servers, stored in any database, or shared with any third party. Your data stays on your device.
      </p>

      <h3 class="text-lg font-semibold text-gray-900">Analytics</h3>
      <p>
        We use <a href="https://plausible.io" target="_blank" rel="noopener noreferrer" class="text-primary underline">Plausible Analytics</a>, a privacy-focused analytics service, to understand how visitors use our website. Plausible does not use cookies, does not collect personal data, and is fully compliant with GDPR, CCPA, and PECR. It tracks only aggregate metrics such as page views, referral sources, and browser type.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Cookies</h2>
      <p>
        SocialSecurityTiming.com does not use cookies. We do not use tracking cookies, advertising cookies, or any other type of cookie. Plausible Analytics is cookieless by design.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Third-Party Services</h2>
      <p>
        We do not integrate with advertising networks, social media tracking pixels, or any third-party service that collects personal information. The only third-party service used is Plausible Analytics, as described above.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Data Security</h2>
      <p>
        Since we do not collect or store personal financial data, there is no risk of your calculator inputs being exposed in a data breach. The website is served over HTTPS to ensure all communications between your browser and our servers are encrypted.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Children's Privacy</h2>
      <p>
        This website is not directed at children under 13, and we do not knowingly collect information from children.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Your Rights</h2>
      <p>
        Since we do not collect personal data, there is no personal data to access, correct, or delete. If you have any questions about our privacy practices, please contact us through our website.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900">Changes to This Policy</h2>
      <p>
        We may update this privacy policy from time to time. Any changes will be reflected on this page with an updated revision date.
      </p>
    </section>
  </div>
</Layout>
